    {
        "id": "a8a1d209077e4c41",
        "type": "function",
        "z": "766e2989eabb3c74",
        "name": "function 1",
        "func": "let slotStates = flow.get('slotStates') || {};\nslotStates[msg.slotId] = msg.occupied;\nflow.set('slotStates', slotStates);\n\nconst allFull = Object.keys(slotStates).length === 4 &&\n                Object.values(slotStates).every(v => v === true);\n\nif (!allFull) return null;\n\nlet subscribers = flow.get('subscribers') || [];\nif (subscribers.length === 0) return null;\n\nmsg.payload = {\n    chatId: subscribers[0],\n    type: 'message',\n    content: '⚠️ SmartPark: Parking lot is FULL — all 4 slots occupied'\n};\nreturn msg;",

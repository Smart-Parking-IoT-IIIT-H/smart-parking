    {
        "id": "48bdaa5445177297",
        "type": "function",
        "z": "766e2989eabb3c74",
        "name": "function 2",
        "func": "if (msg.payload.content !== '/start') return null;\n\nlet subscribers = flow.get('subscribers') || [];\nconst chatId = msg.payload.chatId;\n\nif (!subscribers.includes(chatId)) {\n    subscribers.push(chatId);\n    flow.set('subscribers', subscribers);\n}\n\nmsg.payload = {\n    chatId: chatId,\n    type: 'message',\n    content: '✅ Subscribed to SmartPark alerts!'\n};\nreturn msg;",

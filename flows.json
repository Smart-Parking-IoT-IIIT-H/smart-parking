    {
        "id": "function-1",
        "type": "function",
        "z": "766e2989eabb3c74",
        "name": "Format for Firebase",
        "func": "if (typeof msg.payload === 'string') {\n    msg.payload = JSON.parse(msg.payload);\n}\n\nconst parts = msg.topic.split(\"/\");\nconst slotId = parts[2];\n\nmsg.payload = {\n    occupied: msg.payload.occupied,\n    ir: msg.payload.ir,\n    us: msg.payload.us,\n    error: msg.payload.error || false,\n    timestamp: Math.floor(Date.now() / 1000)\n};\n\nmsg.url = \"https://smart-parking-1df76-default-rtdb.asia-southeast1.firebasedatabase.app/slots/\" + slotId + \".json\";\nmsg.method = \"PUT\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\n\n// ADD THESE TWO LINES\nmsg.slotId = slotId;\nmsg.occupied = msg.payload.occupied;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
